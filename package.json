{
  "name": "agenticloop",
  "version": "0.4.0",
  "description": "Graph engineering for AI coding agents – binding every state change, evidence requirement, and authorization boundary to durable artifacts for multi-hour work",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.8.2",
  "bin": {
    "agenticloop": "./bin/agenticloop.js"
  },
  "exports": {
    ".": "./src/cli-main.js",
    "./auditor-return-receipt": "./src/auditor-return-receipt.js",
    "./audit-report-schema": "./src/audit-report-schema.js",
    "./host-trust": "./src/host-trust.js",
    "./activation-grant": "./src/activation-grant.js",
    "./activation-policy": "./src/activation-policy.js",
    "./protected-host-boundary": "./src/protected-host-boundary.js",
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./*": "./*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bartoszarendt/agenticloop.git"
  },
  "homepage": "https://github.com/bartoszarendt/agenticloop#readme",
  "bugs": {
    "url": "https://github.com/bartoszarendt/agenticloop/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "agentic",
    "graph-engineering",
    "workflow",
    "provenance",
    "assurance",
    "markdown",
    "opencode",
    "codex",
    "claude-code",
    "copilot",
    "cursor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:dot": "node --test --test-reporter=dot \"test/**/*.test.js\"",
    "test:fast": "node scripts/run-tests.js fast",
    "test:e2e": "node scripts/run-tests.js e2e",
    "test:groups": "node scripts/run-tests.js check",
    "test:profile": "node scripts/profile-tests.js",
    "measure:dispatch-context": "node scripts/measure-dispatch-context.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "files": [
    "bin/",
    "src/",
    ".claude-plugin/",
    "scripts/measure-dispatch-context.mjs",
    "scripts/sign-blocked-authority.mjs",
    "AGENTIC_LOOP.md",
    "agents/",
    "backends/",
    "skills/",
    "commands/",
    "memory/",
    "config.json",
    "agenticloop.template.json",
    "manifest.json",
    "docs/getting-started.md",
    "docs/cli-reference.md",
    "docs/downstream-adoption.md",
    "docs/host-adapters.md",
    "docs/opencode-setup.md",
    "docs/codex-setup.md",
    "docs/claude-code-setup.md",
    "docs/copilot-setup.md",
    "docs/cursor-setup.md",
    "docs/skill-anatomy.md",
    "docs/workflow-examples.md",
    "docs/registry-horizon.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^22.20.1",
    "ts5": "npm:typescript@^5.9.2",
    "typescript": "^7.0.2"
  }
}
